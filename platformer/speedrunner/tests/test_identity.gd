extends SceneTree

const Room = preload("res://scripts/room_network.gd")
const Effects = preload("res://scripts/movement_particles.gd")
const Remote = preload("res://scripts/remote_avatar.gd")
var checks := 0
var failures := 0

func _initialize() -> void:
	call_deferred("run")

func check(value: bool, description: String) -> void:
	checks += 1
	if not value: failures += 1; push_error(description)

func run() -> void:
	var room := Room.new()
	root.add_child(room)
	room.set_physics_process(false)
	check(Room.COLORS.size() == Room.MAX_PLAYERS, "each room slot has its own tint")
	var colors: Array[Color] = []
	for color: Color in Room.COLORS:
		if not colors.has(color): colors.append(color)
	check(colors.size() == 16, "all sixteen tint values differ")
	for id in range(2, 17): room.people[id] = room._person("Player %d" % id, room.available_color())
	check(room.available_color() == -1, "a full room has no free color")
	room.people.erase(4)
	check(room.available_color() == 3, "a departure frees its own color rather than duplicating another player")
	room.people[17] = room._person("Replacement", room.available_color())
	var assigned: Array = []
	for person: Dictionary in room.people.values(): assigned.append(person.color)
	check(assigned.size() == 16 and assigned.count(3) == 1 and assigned.count(15) == 1, "replacement preserves other players' colors")
	check(Room.clean_name(" \tBlue\nRunner\u202e ") == "Blue Runner", "names trim whitespace and remove control and bidi formatting")
	check(Room.clean_name("\u200b\t") == "Runner", "blank or invisible names get a readable default")
	check(Room.clean_name("ABCDEFGHIJKLMNOPQRSTUVWXYZ").length() == 20, "name length is bounded")
	check(Room.clean_name("小跑者") == "小跑者", "Unicode usernames are retained")
	room.request_name("  Nova  ")
	check(room.people[1].name == "Nova" and room.local_actor().identity_label.text == "Nova", "accepted names update the player nameplate")
	check(room.unique_name("nova") == "nova 2", "duplicate names get a case-insensitive suffix")
	room.people[2].name = "ABCDEFGHIJKLMNOPQRST"
	check(room.unique_name("ABCDEFGHIJKLMNOPQRST") == "ABCDEFGHIJKLMNOPQR 2", "duplicate suffixes respect the length limit")
	room.name_changes.clear()
	room.request_name("Comet")
	check(room.people[1].color == 0 and room.display_name == "Comet", "renaming preserves the assigned color")
	room.request_name("Spam")
	check(room.people[1].name == "Comet", "rapid repeat name changes are bounded by the host")
	var remote := Remote.new()
	root.add_child(remote)
	remote.configure("Guest", Room.COLORS[4])
	remote.set_identity("Guest renamed", Room.COLORS[4])
	check(remote.label.text == "Guest renamed" and remote.sprite.material.get_shader_parameter("tint") == Room.COLORS[4], "remote avatars use the same identity shader and nameplate")
	check(room.local_actor().sprite.texture == remote.sprite.texture, "local and remote avatars share the original sprite texture")

	var effects := Effects.new()
	root.add_child(effects)
	effects.enabled = true
	effects.sample(0.016, Vector2.ZERO, Vector2.ZERO, true)
	effects.sample(0.016, Vector2.ZERO, Vector2.ZERO, true)
	check(effects.particles.is_empty(), "idle players do not emit dust")
	effects.sample(0.016, Vector2(2, 0), Vector2(200, 0), true)
	check(not effects.particles.is_empty(), "running creates a dust trail")
	effects.reset_tracking(true)
	effects.sample(0.016, Vector2.ZERO, Vector2(420, 0), true)
	effects.sample(0.016, Vector2(6, 0), Vector2(420, 0), true)
	check(effects.particles.size() == 3, "sprinting emits a denser colored trail")
	effects.reset_tracking(true)
	effects.sample(0.016, Vector2.ZERO, Vector2.ZERO, true)
	effects.sample(0.016, Vector2(0, -4), Vector2(0, -600), false)
	check(effects.particles.size() >= 8, "jump takeoff emits a burst")
	effects.reset_tracking(true)
	effects.sample(0.016, Vector2.ZERO, Vector2(0, 300), false)
	effects.sample(0.016, Vector2(0, 4), Vector2.ZERO, true)
	check(effects.particles.size() >= 12, "landing emits an impact burst")
	effects.reset_tracking(true)
	effects.sample(0.016, Vector2.ZERO, Vector2(420, 0), true)
	effects.sample(0.016, Vector2(3, 0), Vector2(150, 0), true)
	check(effects.particles.size() >= 5, "hard braking emits skid dust")
	effects.reset_tracking(true)
	effects.sample(0.016, Vector2.ZERO, Vector2(0, 110), false, true, -1)
	effects.sample(0.016, Vector2(0, 2), Vector2(0, 110), false, true, -1)
	check(effects.particles.size() == 2, "wall sliding emits sparks at the wall")
	effects.reset_tracking(true)
	effects.sample(0.016, Vector2.ZERO, Vector2.ZERO, true)
	effects.sample(0.016, Vector2(200, 0), Vector2(0, -600), false)
	check(effects.particles.is_empty(), "teleports do not produce a false jump burst or a trail across the map")
	for i in 40: effects._burst(Vector2.ZERO, 12, 90, Color.WHITE)
	check(effects.particles.size() <= Effects.MAX_PARTICLES, "particle allocation stays bounded")
	effects.sample(1, Vector2.ZERO, Vector2.ZERO, false, false, 0, false)
	check(effects.particles.is_empty(), "old particles expire while editing or spectating")
	effects._burst(Vector2.ZERO, 12, 90, Color.WHITE)
	effects.enabled = false
	effects.sample(0.016, Vector2.ZERO, Vector2(420, 0), true)
	check(effects.particles.is_empty(), "disabling particles immediately clears the effect")
	room.queue_free(); remote.queue_free(); effects.queue_free()
	print("Identity and effects: %d checks, %d failures" % [checks, failures])
	quit(1 if failures else 0)
