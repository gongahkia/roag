VITE_GAME_SERVER_URL=wss://ws.example.com

# Server process (do not expose PORT directly; proxy it through Caddy or Nginx).
HOST=127.0.0.1
PORT=8787
GAME_DATABASE=/var/lib/golf-with-your-enemies/rooms.sqlite
APP_ORIGINS=https://app.example.com
MAX_COURSE_TILES=4096
ROOM_TTL_HOURS=168
TRUST_PROXY=true
BACKUP_DIR=/var/backups/golf-with-your-enemies
