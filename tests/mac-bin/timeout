#!/usr/bin/env python3
"""Small GNU timeout subset used by the existing GUI smoke scripts on macOS."""
import os
import signal
import subprocess
import sys


def seconds(value):
    unit = value[-1]
    multiplier = {"s": 1, "m": 60, "h": 3600}.get(unit)
    return float(value[:-1]) * multiplier if multiplier else float(value)


args = sys.argv[1:]
grace = 3.0
if args[:1] == ["-k"]:
    if len(args) < 4:
        raise SystemExit("usage: timeout [-k GRACE] DURATION COMMAND...")
    grace = seconds(args[1])
    args = args[2:]
if len(args) < 2:
    raise SystemExit("usage: timeout [-k GRACE] DURATION COMMAND...")
duration = seconds(args[0])
process = subprocess.Popen(args[1:], start_new_session=True)
try:
    code = process.wait(timeout=duration)
except subprocess.TimeoutExpired:
    os.killpg(process.pid, signal.SIGTERM)
    try:
        process.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()
    raise SystemExit(124)
raise SystemExit(128 - code if code < 0 else code)
