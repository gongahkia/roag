[Unit]
Description=Golf With Your Enemies multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=golf
WorkingDirectory=/opt/golf-with-your-enemies
EnvironmentFile=/etc/golf-with-your-enemies.env
ExecStart=/usr/bin/npm run start:server
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
