{
  "name": "roag-colony-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "assets": "node scripts/export-assets.mjs",
    "assets:check": "node scripts/export-assets.mjs --check",
    "predev": "npm run assets",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run assets && npm run typecheck && vite build && node scripts/check-dist.mjs dist",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "npm run assets && npm run assets:check && npm run test && npm run test:browser",
    "test:scenarios": "node scripts/scenarios.mjs && node scripts/work-scenarios.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
