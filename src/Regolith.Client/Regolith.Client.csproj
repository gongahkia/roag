<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Regolith.Core/Regolith.Core.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <Content Include="../../assets/urizen/*.png" Link="assets/urizen/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/godot-node-icons/white/*.png" Link="assets/godot-node-icons/white/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/input-prompts/new/*.png" Link="assets/input-prompts/new/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/runtime-sprites.json" Link="assets/runtime-sprites.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/CREDITS.txt" Link="assets/CREDITS.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
